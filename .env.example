# Discord bot
DISCORD_TOKEN=
# Optional: Mahzen sunucu ID'si; test sunucusunda slash komutlarını anında yayınlar.
DISCORD_GUILD_ID=

# Discord OAuth2 dashboard
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-SERVICE.onrender.com/dashboard/callback

# Application
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
OWNER_DISCORD_ID=
# Required for production dashboard owner access: Base32 secret for an authenticator app (TOTP)
OWNER_TOTP_SECRET=

# Database
# Render deployment must use persistent PostgreSQL; local SQLite is not durable on an ephemeral filesystem.\n# Set DATABASE_URL to your provider URL; postgres:// and postgresql:// are normalized to psycopg.\nDATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# AI provider (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Logging
LOG_LEVEL=INFO

# Database backup retention: 30 days. Local files on Render free services are ephemeral.
BACKUP_DIR=instance/backups
# Optional S3-compatible durable storage (e.g. an S3/R2-compatible bucket)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
