# Discord bot
DISCORD_TOKEN=
# Optional: Mahzen sunucu ID'si; test sunucusunda slash komutlarını anında yayınlar.
DISCORD_GUILD_ID=

# Discord OAuth2 dashboard
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:5000/dashboard/callback

# Application
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
OWNER_DISCORD_ID=

# Database
DATABASE_URL=sqlite:///instance/kaplumbik.db

# AI provider (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Logging
LOG_LEVEL=INFO
