# Discord bot
DISCORD_TOKEN=
# Mahzen server ID; used for command sync and OAuth Administrator access checks
DISCORD_GUILD_ID=
OWNER_DISCORD_ID=

# Discord OAuth2 dashboard
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-FADEHOST-DOMAIN/dashboard/callback

# Application
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
# Required for production owner dashboard access: Base32 TOTP secret
OWNER_TOTP_SECRET=

# Database
# Render free Web Service disk is ephemeral. Use a persistent PostgreSQL database.
# postgres:// and postgresql:// URLs are normalized to postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# AI provider (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Logging
LOG_LEVEL=INFO

# Database backup retention: 30 days
BACKUP_DIR=instance/backups
# Required for encrypted production backups. Generate with Fernet.generate_key().
BACKUP_ENCRYPTION_KEY=
# Optional S3-compatible durable backup storage (use when the host's local filesystem is not persistent)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
